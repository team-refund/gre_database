Project GRE {
  database_type: 'PostgreSQL'
}

// 회원 및 Gmail 연동

Table users {
  id bigint [pk, increment]
  login_id varchar(50) [not null, unique]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  email_verified boolean [not null, default: false]
  users_status varchar(20) [not null, default: 'ACTIVE']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table gmail_connections {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  google_email varchar(320) [not null]
  gmail_connections_status varchar(20) [not null, default: 'CONNECTED']
  oauth_client_registration_id varchar(100)
  oauth_principal_name varchar(200)

  connected_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (oauth_client_registration_id, oauth_principal_name) [unique]
  }

  checks {
    `(oauth_client_registration_id IS NULL) = (oauth_principal_name IS NULL)` [name: 'gmail_connections_oauth_pair_check']
    `gmail_connections_status <> 'DISCONNECTED' OR (oauth_client_registration_id IS NULL AND oauth_principal_name IS NULL)` [name: 'gmail_connections_disconnected_oauth_check']
  }

  Note: '''
    Gmail 연동 상태와 OAuth2 Authorized Client 참조를 관리한다. 회원당 하나의 Gmail 계정을 연결한다.

    gmail_connections_status:
    CONNECTED - Gmail API 사용 가능
    REAUTH_REQUIRED - Refresh Token 무효화 등으로 Google 재인증 필요
    DISCONNECTED - 사용자가 Gmail 연결을 명시적으로 해제

    Gmail API 호출은 CONNECTED 상태에서만 허용한다.
    연결 해제 시 같은 트랜잭션에서 상태를 DISCONNECTED로 바꾸고 두 OAuth 참조를 NULL로 갱신한 뒤 토큰 행을 삭제한다.
  '''
}

Table oauth2_authorized_client {
  client_registration_id varchar(100) [not null]
  principal_name varchar(200) [not null]
  access_token_type varchar(100) [not null]
  access_token_value bytea [not null]
  access_token_issued_at timestamp [not null]
  access_token_expires_at timestamp [not null]
  access_token_scopes varchar(1000)
  refresh_token_value bytea
  refresh_token_issued_at timestamp
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (client_registration_id, principal_name) [pk]
  }

  Note: '''
    Spring Security OAuth2 Authorized Client 저장소.

    client_registration_id = gmail
    principal_name = gre-user:{userId}

    Access Token 및 Refresh Token 영속 저장.
    애플리케이션 레벨 토큰 암호화 별도 적용 필요.
  '''
}

Ref: gmail_connections.(oauth_client_registration_id, oauth_principal_name) > oauth2_authorized_client.(client_registration_id, principal_name)

// 커뮤니티

Table free_posts {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  title varchar(255) [not null]
  content text [not null]

  view_count int [not null, default: 0]
  like_count int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id)
    (created_at)
  }
}

Table question_posts {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  title varchar(255) [not null]
  content text [not null]

  question_category varchar(50)
  question_posts_question_status varchar(20) [not null, default: 'OPEN']
  view_count int [not null, default: 0] 
  checked_commentid int [ref: > community_comments.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz


  indexes {
    (user_id)
    (question_posts_question_status, created_at)
  }
}

Table dispute_posts {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  title varchar(255) [not null]
  content text [not null]

  merchant_name varchar(255)
  purchase_site varchar(255)
  dispute_type varchar(50)
  dispute_posts_resolution_status varchar(30) [not null, default: 'IN_PROGRESS']

  view_count int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]


  indexes {
    (user_id)
    (dispute_type, dispute_posts_resolution_status)
  }
}

Table community_comments {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  free_post_id bigint [ref: > free_posts.id]
  question_post_id bigint [ref: > question_posts.id]
  dispute_post_id bigint [ref: > dispute_posts.id]

  content text [not null] 

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
 

  indexes {
    (free_post_id, created_at)
    (question_post_id, created_at)
    (dispute_post_id, created_at)
    (user_id)
  }

  Note: '''
    세 게시판의 댓글을 통합 관리한다.
    free_post_id, question_post_id, dispute_post_id 중
    정확히 하나만 값이 있어야 한다.

    is_accept 
    '''
}

// 사건, 증빙 및 타임라인

 Table cases {
   id bigint [pk, increment]
   user_id bigint [not null, ref: > users.id]

   title varchar(255) [not null]
   case_type varchar(50) [not null]
   cases_status varchar(30) [not null, default: 'REGISTERED']

   merchant_name varchar(255) [not null]
   purchase_site varchar(500) [not null]
   merchant_email varchar(255) [not null]
   order_number varchar(100)

   purchase_date date
   payment_amount decimal(15,2) // 원화(KRW) 기준 결제 금액

   created_at timestamptz [not null, default: `now()`]
   updated_at timestamptz [not null, default: `now()`]
   resolved_at timestamptz

   indexes {
     (user_id)
     (user_id, cases_status)
     (created_at)
   }

   Note: '''
     case_type:
     REFUND_DELAY
     REFUND_NOT_PROCESSED
     DUPLICATE_CHARGE
     PAYMENT_CORRECTION

     cases_status:
     REGISTERED
     ANALYZING
     NEED_USER_INFO
     WAITING_APPROVAL
     IN_PROGRESS
     RESOLVED
     CLOSED
   '''
 }

 Table case_evidences {
   id bigint [pk, increment]
   case_id bigint [not null, ref: > cases.id]

   evidence_type varchar(50) [not null]
   description text

   original_filename varchar(255) [not null]
   stored_filename varchar(255) [not null]
   file_path varchar(1000) [not null]
   file_size bigint [not null]
   content_type varchar(100)

   case_evidences_analysis_status varchar(20) [not null, default: 'PENDING']

   created_at timestamptz [not null, default: `now()`]
   updated_at timestamptz [not null, default: `now()`]

   indexes {
     (case_id) 
     (case_id, evidence_type)
   }

   Note: '''
     evidence_type:
     ORDER_CONFIRMATION
     CONVERSATION

     case_evidences_analysis_status:
     PENDING
     PROCESSING
     COMPLETED
     FAILED

     파일 원본은 무조건 사진이며 백엔드 파일 시스템에 저장한다.
     DB에는 파일 경로 및 메타데이터만 저장한다.
   '''
 }

 Table case_status_histories {
   id bigint [pk, increment]
   case_id bigint [not null, ref: > cases.id]
   case_timeline_status varchar(30)
   description text
   created_at timestamptz [not null, default: `now()`]

   indexes {
     (case_id, created_at)
   }

   Note: '''
     changed_by:
     USER
     SYSTEM
     AI

     최초 등록 시 previous_status는 NULL.
     사건 상태 변경마다 이력을 기록한다.
   '''
 }

Table case_interactions {
  id bigint [pk, increment]

  case_id bigint [not null, ref: > cases.id]
  run_id bigint [not null, ref: > orchestrator_runs.id]

  interaction_type varchar(20) [not null]
  prompt text [not null]

  options jsonb
  response jsonb

  case_interactions_status varchar(20) [not null, default: 'PENDING']

  created_at timestamptz [not null, default: `now()`]
  responded_at timestamptz

  Note: '''
    interaction_type:
    TEXT
    SELECT
    FILE_UPLOAD

    case_interactions_status:
    PENDING
    ANSWERED
    CANCELLED

    Orchestrator가 요청한 사용자 입력을 관리한다.

    사용자 답변 이후 새로운 Run을 생성한다.
    기존 Run을 재개하지 않는다.
  '''
}

// 이메일 작성 및 발송

 Table email_drafts {
   id bigint [pk, increment]
   case_id bigint [not null, ref: > cases.id]

   purpose varchar(100) [not null]
   recipient_email varchar(255)

   subject varchar(255) [not null]
   body text [not null]

   email_drafts_status varchar(20) [not null, default: 'DRAFT']

   created_at timestamptz [not null, default: `now()`]
   updated_at timestamptz [not null, default: `now()`]

   indexes {
     (case_id)
     (case_id, email_drafts_status)
   }

   Note: '''
     purpose:
     REFUND_REQUEST
     PAYMENT_CORRECTION
     ADDITIONAL_INFORMATION
     FOLLOW_UP
     OTHER

     email_drafts_status:
     DRAFT - 이메일 작성 중이거나 수정으로 재승인이 필요한 상태
     FINALIZED - 사용자가 현재 이메일 초안을 확인하고 발송 승인한 상태
     SENT - Gmail 발송 성공과 메시지 ID 저장이 완료된 상태

     승인된 초안의 수신자, 제목, 본문 또는 첨부를 수정하면 DRAFT로 전환한다.
     발송이 진행 중이거나 결과 확인 중인 초안의 수정은 차단한다.
     SENT 초안은 수정할 수 없으며 새 발송에는 새 초안을 만든다.

     사용자와 AI의 대화에 따라
     subject, body를 갱신한다.
   '''
 }

Table email_draft_attachments {
  id bigint [pk, increment]

  email_draft_id bigint [not null, ref: > email_drafts.id]
  evidence_id bigint [not null, ref: > case_evidences.id]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (email_draft_id, evidence_id) [unique]
    (evidence_id)
  }

  Note: '''
    이메일 초안과 사건 증빙의 N:M 연결 테이블.

    하나의 이메일에 여러 증빙 첨부 가능.
    하나의 증빙을 여러 이메일에서 재사용 가능.

    동일 이메일에 동일 증빙의 중복 첨부 방지.
  '''
}

Table email_draft_messages {
  id bigint [pk, increment]
  email_draft_id bigint [not null, ref: > email_drafts.id]
  role varchar(20) [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (email_draft_id, created_at, id)
  }

  Note: '''
    작성 대화의 USER 및 ASSISTANT 메시지 원문을 저장한다.
    사건 범위는 email_drafts.case_id로 제한한다.
  '''
}

Table email_draft_message_embeddings {
  id bigint [pk, increment]
  message_id bigint [not null, ref: > email_draft_messages.id]
  embedding_model varchar(100) [not null]
  embedding vector [not null]
  embedded_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, embedding_model) [unique]
  }

  Note: '''
    메시지별 모델 임베딩을 pgvector에 저장한다.
    같은 모델의 벡터만 비교하고 초안의 사건 범위 안에서 검색한다.
  '''
}

Table email_send_attempts {
  id bigint [pk, increment]
  email_draft_id bigint [not null, ref: - email_drafts.id, unique]
  gmail_connection_id bigint [not null, ref: > gmail_connections.id]
  request_key varchar(255) [not null, unique]
  message_id_header varchar(255) [not null, unique]
  email_send_attempts_status varchar(20) [not null, default: 'SENDING']
  gmail_message_id varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  gmail_thread_id varchar(255)
  attempt_count int [not null, default: 1]
  error_message text
  sent_at timestamptz

  indexes {
    (gmail_connection_id, gmail_message_id) [unique]
  }

  Note: '''
    상태는 SENDING, UNKNOWN, FAILED, SENT를 사용한다.
    서버는 초안과 첨부 변경을 초안 행 잠금으로 직렬화한다.
    회원·사건 소유권, Gmail 연결, FINALIZED 상태를 검증하고 초안당 한 행으로 발송을 선점한다.
    선점 트랜잭션 커밋 후 고정된 Message-ID 헤더로 Gmail을 호출한다.
    Gmail 성공 시 스레드·발송 메시지 및 Gmail 메시지 ID를 저장하고 초안과 발송 행을 같은 트랜잭션에서 SENT로 변경한다.
    타임아웃이나 중단으로 결과가 불확실하면 재전송을 막고 Gmail 발송함에서 Message-ID로 확인한다.
    검색 결과가 없다는 이유만으로 재전송하지 않는다. 미발송이 확정된 FAILED만 기존 발송 행으로 다시 선점한다.
    기존 FINALIZED에 명시적 승인 근거가 없는 환경에서는 발송 기능 적용 전에 DRAFT로 되돌린다.
  '''
}

Table case_email_threads {
  id bigint [pk, increment]
  case_id bigint [not null, ref: > cases.id]
  gmail_connection_id bigint [not null, ref: > gmail_connections.id]
  gmail_thread_id varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (gmail_connection_id, gmail_thread_id) [unique]
    (case_id)
  }
}

Table email_messages {
  id bigint [pk, increment]
  case_email_thread_id bigint [not null, ref: > case_email_threads.id]

  gmail_message_id varchar(255) [not null]
  sender_email varchar(320) [not null]
  recipient_email text
  subject varchar(500)
  body text
  direction varchar(10) [not null]

  received_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (case_email_thread_id, gmail_message_id) [unique]
    (case_email_thread_id, received_at)
  }

  Note: '''
    direction:
    INBOUND
    OUTBOUND

    Gmail에서 조회한 송수신 이메일을 저장한다.
    동일 스레드 내 동일 Gmail 메시지의 중복 저장을 방지한다.
  '''
}

// AI 판단 및 정책 검색

Table orchestrator_runs {
  id bigint [pk, increment]
  case_id bigint [not null, ref: > cases.id]

  trigger_type varchar(30) [not null]
  trigger_key varchar(255) [not null]

  orchestrator_runs_status varchar(20) [not null, default: 'PENDING']
  next_action varchar(50)

  result_data jsonb
  error_message text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (case_id, created_at)
    (case_id, trigger_type, trigger_key) [unique]
  }

  Note: '''
    trigger_type:
    CASE_CREATED
    EVIDENCE_ADDED
    EMAIL_RECEIVED
    USER_INFO_UPDATED
    REFUND_CONFIRMED

    orchestrator_runs_status:
    PENDING
    PROCESSING
    COMPLETED
    FAILED

    Orchestrator AI는 Spring AI Tool Calling으로
    전문 AI와 Tool을 선택적으로 호출한다.

    result_data에 하위 실행 결과,
    최종 판단 근거 및 입력 데이터 참조를 저장한다.

    Spring Boot는 Run 실행 상태와
    실행 결과의 영속화를 담당한다.
  '''
}

Table policy_rag_results {
  id bigint [pk, increment, note: '정책 RAG 결과의 고유 ID.']
  clauses jsonb [not null, default: `'[]'::jsonb`, note: '응답의 clauses 배열. 항목은 chunkId, policyName, articleTitle, articleNumber, originalTextEn, officialUrl을 담는다.']
  reviews jsonb [not null, default: `'[]'::jsonb`, note: '응답의 reviews 배열. 항목은 chunkId, applicability, reason, missingInformation을 담는다.']
  evidence_gaps text [note: '응답의 evidenceGaps. 사건에서 추가로 확인할 거래 사실이나 준비할 증빙에 대한 보완 노트.']

  checks {
    `jsonb_typeof(clauses) = 'array'` [name: 'policy_rag_results_clauses_array_check']
    `jsonb_typeof(reviews) = 'array'` [name: 'policy_rag_results_reviews_array_check']
  }

  Note: '''
    사건별 조회는 orchestrator_runs.result_data의 policyRagResultId로 이 테이블의 id를 찾는다.
    caseId는 orchestrator_runs.case_id에서 가져오며 searchStatus는 실험용 응답에서만 사용한다.
    clauses와 reviews는 chunkId로 연결한다. originalTextEn에는 연속된 영문 원문 발췌를 저장한다.
    발췌문이 없는 청크와 해당 청크의 검토 항목은 배열에서 제외한다.
  '''
}

Table policy_vector_store {
  id uuid [pk, note: '공식 정책 조항 청크의 고유 ID']
  content text [not null, note: '공식 HTML에서 추출한 영어 조항. 제목과 번호, 적용 조건, 기한, 예외를 함께 보존한다.']
  metadata jsonb [not null, note: '검색 범위, 공식 출처, 마지막 정상 적재 시각.']
  embedding vector [not null, note: '조항의 검색용 임베딩. 벡터 차원은 임베딩 모델 선정 후 확정한다.']

  Note: '''
    한 행은 공식 정책의 영어 조항 청크 한 건이다.
    metadata 필수 키는 platform, site, sourceUrl, policyTitle, updatedAt이다.
    checkout_site를 platform과 site로 매핑해 검색하고, sourceUrl과 policyTitle을 공식 출처로 전달한다.
    updatedAt은 문서의 마지막 정상 적재 시각이다(ISO 8601). 같은 문서의 청크에 동일한 값을 넣는다.
    갱신은 (platform, site, sourceUrl) 단위로 처리한다. 새 청크와 임베딩이 준비되면 한 트랜잭션에서 교체한다.
  '''
}

TableGroup "회원 및 Gmail 연동" [color: #2563EB] {
  users
  gmail_connections
  oauth2_authorized_client
}

TableGroup "커뮤니티" [color: #0F766E] {
  free_posts
  question_posts
  dispute_posts
  community_comments
}

TableGroup "사건, 증빙 및 타임라인" [color: #B45309] {
  cases
  case_evidences
  case_status_histories
  case_interactions
}

TableGroup "이메일 작성 및 발송" [color: #7C3AED] {
  email_drafts
  email_draft_attachments
  email_draft_messages
  email_draft_message_embeddings
  email_send_attempts
  case_email_threads
  email_messages
}

TableGroup "AI 판단 및 정책 검색" [color: #BE185D] {
  orchestrator_runs
  policy_rag_results
  policy_vector_store
}
