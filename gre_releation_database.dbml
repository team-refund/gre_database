Project GRE {
  database_type: 'PostgreSQL'
}

// ==========================================
// 1. 회원
// ==========================================

Table users {
  id bigint [pk, increment]
  login_id varchar(50) [not null, unique]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  email_verified boolean [not null, default: false]
  status varchar(20) [not null, default: 'ACTIVE']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

// ==========================================
// 2. 자유게시판
// ==========================================

Table free_posts {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  title varchar(255) [not null]
  content text [not null]

  view_count int [not null, default: 0]
  like_count int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id)
    (created_at)
  }
}

// ==========================================
// 3. 질문게시판
// ==========================================

Table question_posts {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  title varchar(255) [not null]
  content text [not null]

  question_category varchar(50)
  question_status varchar(20) [not null, default: 'OPEN']
  view_count int [not null, default: 0] 
  checked_commentid int [ref: > community_comments.id]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz


  indexes {
    (user_id)
    (question_status, created_at)
  }
}

// ==========================================
// 4. 피해 사례 공유 게시판
// ==========================================

Table dispute_posts {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  title varchar(255) [not null]
  content text [not null]

  merchant_name varchar(255)
  purchase_site varchar(255)
  dispute_type varchar(50)
  resolution_status varchar(30) [not null, default: 'IN_PROGRESS']

  view_count int [not null, default: 0]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]


  indexes {
    (user_id)
    (dispute_type, resolution_status)
  }
}

// ==========================================
// 5. 통합 댓글
// ==========================================

Table community_comments {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]

  free_post_id bigint [ref: > free_posts.id]
  question_post_id bigint [ref: > question_posts.id]
  dispute_post_id bigint [ref: > dispute_posts.id]

  content text [not null] 

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
 

  indexes {
    (free_post_id, created_at)
    (question_post_id, created_at)
    (dispute_post_id, created_at)
    (user_id)
  }

  Note: '''
    세 게시판의 댓글을 통합 관리한다.
    free_post_id, question_post_id, dispute_post_id 중
    정확히 하나만 값이 있어야 한다.

    is_accept 
    '''
}


 // ==========================================
 // 6. 사건
 // FR-003 사건 생성·조회
 // ==========================================

 Table cases {
   id bigint [pk, increment]
   user_id bigint [not null, ref: > users.id]

   title varchar(255) [not null]
   case_type varchar(50) [not null]
   status varchar(30) [not null, default: 'REGISTERED']

   merchant_name varchar(255) [not null]
   purchase_site varchar(500) [not null]
   order_number varchar(100)

   purchase_date date
   payment_amount decimal(15,2) // 원화(KRW) 기준 결제 금액

   created_at timestamptz [not null, default: `now()`]
   updated_at timestamptz [not null, default: `now()`]
   resolved_at timestamptz

   indexes {
     (user_id)
     (user_id, status)
     (created_at)
   }

   Note: '''
     case_type:
     REFUND_DELAY
     REFUND_NOT_PROCESSED
     DUPLICATE_CHARGE
     PAYMENT_CORRECTION

     status:
     REGISTERED
     ANALYZING
     NEED_USER_INFO
     WAITING_APPROVAL
     IN_PROGRESS
     RESOLVED
     CLOSED
   '''
 }

 // ==========================================
 // 7. 사건 증빙
 // FR-004 증빙 등록·관리
 // ==========================================

 Table case_evidences {
   id bigint [pk, increment]
   case_id bigint [not null, ref: > cases.id]

   evidence_type varchar(50) [not null]
   description text

   original_filename varchar(255) [not null]
   stored_filename varchar(255) [not null]
   file_path varchar(1000) [not null]
   file_size bigint [not null]
   content_type varchar(100)

   analysis_status varchar(20) [not null, default: 'PENDING']

   created_at timestamptz [not null, default: `now()`]
   updated_at timestamptz [not null, default: `now()`]

   indexes {
     (case_id) 
     (case_id, evidence_type)
   }

   Note: '''
     evidence_type:
     ORDER_CONFIRMATION
     PAYMENT_RECORD
     REFUND_RECORD
     SCREENSHOT
     PHOTO
     CONVERSATION
     OTHER

     analysis_status:
     PENDING
     PROCESSING
     COMPLETED
     FAILED

     파일 원본은 백엔드 파일 시스템에 저장한다.
     DB에는 파일 경로 및 메타데이터만 저장한다.
   '''
 }

 // ==========================================
 // 8. 사건 상태 이력
 // FR-005 사건 조회 및 상태 이력
 // ==========================================

 Table case_status_histories {
   id bigint [pk, increment]
   case_id bigint [not null, ref: > cases.id]
   status varchar(30)
   description text
   created_at timestamptz [not null, default: `now()`]

   indexes {
     (case_id, created_at)
   }

   Note: '''
     changed_by:
     USER
     SYSTEM
     AI

     최초 등록 시 previous_status는 NULL.
     사건 상태 변경마다 이력을 기록한다.
   '''
 }


 // ==========================================
 // 9. AI 이메일 초안
 // FR-010 대화형 영문 이메일 작성·수정
 // ==========================================

 Table email_drafts {
   id bigint [pk, increment]
   case_id bigint [not null, ref: > cases.id]

   purpose varchar(100) [not null]
   recipient_email varchar(255)

   subject varchar(255) [not null]
   body text [not null]

   status varchar(20) [not null, default: 'DRAFT']
   revision bigint [not null, default: 1]

   created_at timestamptz [not null, default: `now()`]
   updated_at timestamptz [not null, default: `now()`]

   indexes {
     (case_id)
     (case_id, status)
   }

   Note: '''
     purpose:
     REFUND_REQUEST
     PAYMENT_CORRECTION
     ADDITIONAL_INFORMATION
     FOLLOW_UP
     OTHER

     status:
     DRAFT - 이메일 작성 중이거나 수정으로 재승인이 필요한 상태
     FINALIZED - 사용자가 현재 이메일 초안을 확인하고 발송 승인한 상태
     SENT - Gmail 발송 성공과 메시지 ID 저장이 완료된 상태

     승인된 초안의 수신자, 제목, 본문 또는 첨부를 수정하면 revision을 증가시키고 DRAFT로 전환한다.
     승인 요청은 사용자가 확인한 revision을 검증한다. 발송이 진행 중이거나 결과 확인 중인 초안의 수정은 차단한다.
     SENT 초안은 수정할 수 없으며 새 발송에는 새 초안을 만든다.

     사용자와 AI의 대화에 따라
     subject, body를 갱신한다.
   '''
 }


// ==========================================
// 10. Gmail 연동 및 리프레시 토큰 관리
// ==========================================

Table gmail_connections {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  google_email varchar(320) [not null]
  refresh_token_encrypted text
  scopes text [not null]
  status varchar(20) [not null, default: 'CONNECTED']
  connected_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Gmail 연동 및 암호화된 리프레시 토큰 관리. 회원당 하나의 Gmail 계정을 연결한다.'
}

// ==========================================
// 11. 이메일 증빙 첨부 (N:M)
// ==========================================

Table email_draft_attachments {
  id bigint [pk, increment]

  email_draft_id bigint [not null, ref: > email_drafts.id]
  evidence_id bigint [not null, ref: > case_evidences.id]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (email_draft_id, evidence_id) [unique]
    (evidence_id)
  }

  Note: '''
    이메일 초안과 사건 증빙의 N:M 연결 테이블.

    하나의 이메일에 여러 증빙 첨부 가능.
    하나의 증빙을 여러 이메일에서 재사용 가능.

    동일 이메일에 동일 증빙의 중복 첨부 방지.
  '''
}

Table case_email_threads {
  id bigint [pk, increment]
  case_id bigint [not null, ref: > cases.id]
  gmail_connection_id bigint [not null, ref: > gmail_connections.id]
  gmail_thread_id varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (gmail_connection_id, gmail_thread_id) [unique]
    (case_id)
  }
}

Table email_messages {
  id bigint [pk, increment]
  case_email_thread_id bigint [not null, ref: > case_email_threads.id]

  gmail_message_id varchar(255) [not null]
  sender_email varchar(320) [not null]
  recipient_email text
  subject varchar(500)
  body text
  direction varchar(10) [not null]

  received_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (case_email_thread_id, gmail_message_id) [unique]
    (case_email_thread_id, received_at)
  }

  Note: '''
    direction:
    INBOUND
    OUTBOUND

    Gmail에서 조회한 송수신 이메일을 저장한다.
    동일 스레드 내 동일 Gmail 메시지의 중복 저장을 방지한다.
  '''
}

Table orchestrator_runs {
  id bigint [pk, increment]
  case_id bigint [not null, ref: > cases.id]

  trigger_type varchar(30) [not null]
  trigger_key varchar(255) [not null]

  status varchar(20) [not null, default: 'PENDING']
  next_action varchar(50)

  result_data jsonb
  error_message text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (case_id, created_at)
    (case_id, trigger_type, trigger_key) [unique]
  }

  Note: '''
    trigger_type:
    CASE_CREATED
    EVIDENCE_ADDED
    EMAIL_RECEIVED
    USER_INFO_UPDATED
    REFUND_CONFIRMED

    status:
    PENDING
    PROCESSING
    COMPLETED
    FAILED

    Orchestrator AI는 Spring AI Tool Calling으로
    전문 AI와 Tool을 선택적으로 호출한다.

    result_data에 하위 실행 결과,
    최종 판단 근거 및 입력 데이터 참조를 저장한다.

    Spring Boot는 Run 실행 상태와
    실행 결과의 영속화를 담당한다.
  '''
}

Table case_interactions {
  id bigint [pk, increment]

  case_id bigint [not null, ref: > cases.id]
  run_id bigint [not null, ref: > orchestrator_runs.id]

  interaction_type varchar(20) [not null]
  prompt text [not null]

  options jsonb
  response jsonb

  status varchar(20) [not null, default: 'PENDING']

  created_at timestamptz [not null, default: `now()`]
  responded_at timestamptz

  Note: '''
    interaction_type:
    TEXT
    SELECT
    FILE_UPLOAD

    status:
    PENDING
    ANSWERED
    CANCELLED

    Orchestrator가 요청한 사용자 입력을 관리한다.

    사용자 답변 이후 새로운 Run을 생성한다.
    기존 Run을 재개하지 않는다.
  '''
}

Table email_send_attempts {
  id bigint [pk, increment]
  email_draft_id bigint [not null, ref: - email_drafts.id, unique]
  gmail_connection_id bigint [not null, ref: > gmail_connections.id]
  draft_revision bigint [not null]
  request_key varchar(255) [not null, unique]
  message_id_header varchar(255) [not null, unique]
  status varchar(20) [not null, default: 'SENDING']
  gmail_message_id varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  gmail_thread_id varchar(255)
  attempt_count int [not null, default: 1]
  error_message text
  sent_at timestamptz

  indexes {
    (gmail_connection_id, gmail_message_id) [unique]
  }

  Note: '''
    상태는 SENDING, UNKNOWN, FAILED, SENT를 사용한다.
    서버는 초안과 첨부 변경을 초안 행 잠금으로 직렬화한다.
    회원·사건 소유권, Gmail 연결, FINALIZED 및 revision을 검증하고 초안당 한 행으로 발송을 선점한다.
    선점 트랜잭션 커밋 후 고정된 Message-ID 헤더로 Gmail을 호출한다.
    Gmail 성공 시 스레드·발송 메시지 및 Gmail 메시지 ID를 저장하고 초안과 발송 행을 같은 트랜잭션에서 SENT로 변경한다.
    타임아웃이나 중단으로 결과가 불확실하면 재전송을 막고 Gmail 발송함에서 Message-ID로 확인한다.
    검색 결과가 없다는 이유만으로 재전송하지 않는다. 미발송이 확정된 FAILED만 기존 발송 행으로 다시 선점한다.
    기존 FINALIZED에 명시적 승인 근거가 없는 환경에서는 발송 기능 적용 전에 DRAFT로 되돌린다.
  '''
}

Table email_draft_messages {
  id bigint [pk, increment]
  email_draft_id bigint [not null, ref: > email_drafts.id]
  role varchar(20) [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (email_draft_id, created_at, id)
  }

  Note: '''
    작성 대화의 USER 및 ASSISTANT 메시지 원문을 저장한다.
    사건 범위는 email_drafts.case_id로 제한한다.
  '''
}

Table email_draft_message_embeddings {
  id bigint [pk, increment]
  message_id bigint [not null, ref: > email_draft_messages.id]
  embedding_model varchar(100) [not null]
  embedding vector [not null]
  embedded_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, embedding_model) [unique]
  }

  Note: '''
    메시지별 모델 임베딩을 pgvector에 저장한다.
    같은 모델의 벡터만 비교하고 초안의 사건 범위 안에서 검색한다.
  '''
}
